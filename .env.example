# ── Contact form (choose SMTP or Resend) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO_EMAIL=aaromalrm@gmail.com

# ── Site URL (SEO / canonical) ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aromalramesh.dev

# ── Spotify "Last Played" (optional) ──────────────────────────────────────────
# See README "Spotify Integration" for how to get these.
# If left blank, the site shows the fallback track from lib/data.ts.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
